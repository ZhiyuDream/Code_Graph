# Neo4j 配置
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# 目标仓库（待解析的 C++ 仓库根目录）
REPO_ROOT=/data/users/zzy/RUC/llama.cpp
# 含 compile_commands.json 的目录，一般为仓库的 build 目录；留空则自动尝试 REPO_ROOT/build
COMPILE_COMMANDS_DIR=/data/users/zzy/RUC/llama.cpp/build

# GitHub 配置（可选，仅 Issue/PR 摄取需要）
GITHUB_TOKEN=your_github_token
GITHUB_REPO=ggerganov/llama.cpp

# OpenAI 兼容 API（OpenAI / 中转 / 本地 vLLM / Ollama 等）
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
